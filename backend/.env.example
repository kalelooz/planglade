DATABASE_URL="file:../db/custom.db"

# Local development works without Firebase.
PLANGLADE_AUTH_MODE="dev"
NEXT_PUBLIC_PLANGLADE_AUTH_MODE="dev"

# Local attachment storage (the Docker and public self-host default).
PLANGLADE_STORAGE_PROVIDER="local"
PLANGLADE_LOCAL_STORAGE_DIR="storage/local-attachments"
PLANGLADE_STORAGE_SIGNING_SECRET="replace-with-a-random-local-secret"
PLANGLADE_WORKSPACE_STORAGE_QUOTA_BYTES="1073741824"
PLANGLADE_STORAGE_MIN_FREE_BYTES="268435456"

# NextAuth is required when PLANGLADE_AUTH_MODE is set to "nextauth".
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-random-nextauth-secret"
GOOGLE_CLIENT_ID="replace-with-google-client-id"
GOOGLE_CLIENT_SECRET="replace-with-google-client-secret"

# Initial workspace defaults.
PLANGLADE_WORKSPACE_SLUG="my-workspace"
PLANGLADE_WORKSPACE_NAME="My Workspace"

# Email delivery is disabled by default.
PLANGLADE_EMAIL_PROVIDER="disabled"
PLANGLADE_EMAIL_FROM="PlanGlade <noreply@example.com>"

# Protects maintenance job endpoints.
PLANGLADE_MAINTENANCE_TOKEN="replace-with-random-maintenance-token"
