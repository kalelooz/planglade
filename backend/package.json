{
  "name": "planglade",
  "version": "0.2.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=20.9.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "validate:auth-config": "node scripts/validate-auth-config.mjs",
    "build": "npm run validate:auth-config && next build && node scripts/postbuild-copy.js",
    "start": "npm run validate:auth-config && node .next/standalone/server.js",
    "test": "node --import tsx --test --test-concurrency=1 tests/**/*.test.ts",
    "check:readme-sync": "node scripts/check-readme-sync.mjs",
    "jobs:expire-invites": "node scripts/expire-workspace-invites.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:backend-surface": "node scripts/check-backend-surface.mjs",
    "ci:check": "npm run check:backend-surface && npm run typecheck && npm run lint",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:check:local-auth-emails": "node scripts/preflight-local-auth-emails.mjs",
    "db:check:attachment-storage-keys": "node scripts/check-attachment-storage-key-duplicates.mjs",
    "db:reset": "prisma migrate reset"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "firebase-admin": "^14.1.0",
    "next": "16.3.0",
    "next-auth": "^4.24.15",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "sharp": "^0.35.3",
    "zod": "^4.0.2"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "prisma": "^6.19.3",
    "tsx": "^4.22.3",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "^8.5.15",
    "gaxios": "^7.2.0",
    "retry-request": "^8.0.3",
    "teeny-request": "^10.1.3",
    "uuid": "^11.1.1"
  }
}
