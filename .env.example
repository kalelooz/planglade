PLANGLADE_PORT=8080
PLANGLADE_PUBLIC_URL=http://localhost:8080

NEXTAUTH_SECRET=replace-with-a-long-random-secret
PLANGLADE_SETUP_TOKEN=replace-with-a-random-setup-token
PLANGLADE_LOCAL_AUTH_ENABLED=true
# Optional OAuth provider. Local email/password works without it.
# GOOGLE_CLIENT_ID=replace-with-google-client-id
# GOOGLE_CLIENT_SECRET=replace-with-google-client-secret

# Optional override. A separate key is derived from NEXTAUTH_SECRET by default.
# PLANGLADE_STORAGE_SIGNING_SECRET=replace-with-a-different-long-random-secret
PLANGLADE_WORKSPACE_SLUG=my-workspace
PLANGLADE_WORKSPACE_NAME=My Workspace

PLANGLADE_EMAIL_PROVIDER=disabled
PLANGLADE_EMAIL_FROM=PlanGlade <noreply@example.com>
# PLANGLADE_MAINTENANCE_TOKEN=replace-with-a-long-random-maintenance-token
